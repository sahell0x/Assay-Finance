# Browser-facing API URL.
#
# Local: http://localhost:8000
# Production: https://api.xyz.in
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server/container-facing API URL used by the Next server and Docker build.
# When the full stack is started from the repo root, "api" is the backend service name.
BACKEND_URL=http://api:8000

# Host port for the frontend container.
WEB_HOST_PORT=3000
