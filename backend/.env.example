# =========================================================================
# Copy this file to .env and set OPENAI_API_KEY. That is enough to run locally.
#
# Production uses separate frontend and backend subdomains. For example:
#
#   frontend  https://app.equity.sahell.in
#   backend   https://api.equity.sahell.in
#
#   ENV=prod
#   OPENAI_API_KEY=sk-...
#   AUTH_SECRET=<openssl rand -hex 32>
#   IP_HASH_SALT=<openssl rand -hex 16>
#   COOKIE_SECURE=true
#   COOKIE_DOMAIN=.equity.sahell.in
#   CORS_ORIGINS=https://app.equity.sahell.in
#   FRONTEND_URL=https://app.equity.sahell.in
#   API_PUBLIC_URL=https://api.equity.sahell.in
#
# COOKIE_DOMAIN must be the shared parent domain so cookies set by api.* are available
# to app.*. CORS_ORIGINS must be the frontend origin exactly.
#
# DATABASE_URL and REDIS_URL change only if you move off the bundled containers
# onto a managed Postgres or Redis.
#
# `make doctor` fails the run if any of these are wrong. Check it after deploying.
# =========================================================================

# ---- datastores ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://equity:equity@localhost:5432/equity
REDIS_URL=redis://localhost:6379/0

# ---- models -------------------------------------------------------------
# The app speaks the OpenAI API and nothing else, so anything that serves it will do.
# Pick a provider and fill in that provider's block below; leave the rest blank.
#
#   openai      official api.openai.com
#   azure       an Azure OpenAI resource (MODEL_* are deployment names, not model IDs)
#   compatible  any OpenAI-compatible gateway — aicredits.in, OpenRouter, LiteLLM, vLLM
#
# With no key at all the pipeline still runs end to end: every figure is computed from
# the filings as usual and the narratives become clearly-labelled placeholders.
LLM_PROVIDER=openai

# -- official OpenAI ------------------------------------------------------
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=            # blank; the SDK default is https://api.openai.com/v1
#
# -- Azure OpenAI ---------------------------------------------------------
#   LLM_PROVIDER=azure
#   OPENAI_API_KEY=<the resource key>
#   AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
#   AZURE_OPENAI_API_VERSION=2024-10-21
#   MODEL_NARRATIVE=gpt-4o-mini-deployment   # deployment names, as created in Azure
#   MODEL_MEMO=gpt-4o-deployment
#
# -- an OpenAI-compatible gateway ----------------------------------------
#   LLM_PROVIDER=compatible
#   OPENAI_API_KEY=<the gateway's key>
#   OPENAI_BASE_URL=https://aicredits.in/v1  # include the /v1; required for this mode
#   MODEL_NARRATIVE=<an ID the gateway lists>
#   EMBEDDING_BASE_URL=                      # see the embeddings block below

OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Routing. The memo is the only one of these worth thinking about: it is the single
# call that receives all four metric blocks plus the whole evidence set, so it is about
# half the tokens of a run — and on the top tier it was 84% of the bill, because that
# tier costs 12x the input and 25x the output of the cheap one.
#
#   MODEL_MEMO=gpt-5.6-terra   ~$4.14 per 1,000 analyses   (the default)
#   MODEL_MEMO=gpt-5.6-sol     ~$10.42 per 1,000 analyses
#
# What you are trading is prose quality and nothing else. The rating comes from a fixed
# rubric, every figure is computed in Python, citations are enforced in Python, and the
# numeric verifier checks the draft either way — so a cheaper memo model writes a
# plainer argument, it does not make the analysis less correct.
#
# `make costs --compare` prices these against your own runs rather than this estimate.
MODEL_NARRATIVE=gpt-5.6-luna
MODEL_RAG=gpt-5.6-terra
MODEL_MEMO=gpt-5.6-terra
MODEL_CRITIC=gpt-5.6-luna
# Used only when a configured model above is missing from the provider's model list.
# The substitute is chosen by price — the entry nearest what you configured, preferring
# not to exceed it — rather than by size, so a missing ID can never quietly cost you
# more than the model it stands in for. Substitutions are logged and shown by
# scripts/doctor.py.
MODEL_FALLBACKS=gpt-4.1-mini,gpt-4o-mini,gpt-4.1,gpt-4o,gpt-4o-2024-08-06

# ---- embeddings ---------------------------------------------------------
# Gateways very often proxy chat completions and nothing else. These four exist so the
# embeddings can be sent somewhere the chat traffic is not — set EMBEDDING_PROVIDER to
# openai and EMBEDDING_API_KEY to a real OpenAI key while LLM_PROVIDER stays
# compatible, for instance. Every blank value falls back to its chat equivalent, so a
# single-provider setup leaves them all empty.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Changing this after the first index is built means a migration: the pgvector column
# is declared at this width.
EMBEDDING_DIMS=512

# ---- external data ------------------------------------------------------
# SEC returns 403 without a descriptive User-Agent carrying a contact address.
SEC_USER_AGENT="Equity Research Agent you@example.com"

# ---- auth ---------------------------------------------------------------
AUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Optional — leave both blank and the app runs on email and password alone.
# Register a "Web application" client at console.cloud.google.com and give it:
#
#   Authorized JavaScript origins   http://localhost:3000
#                                   https://app.equity.sahell.in
#   Authorized redirect URIs        http://localhost:8000/auth/google/callback
#                                   https://api.equity.sahell.in/auth/google/callback
#
# One client can hold both, so the same credentials work locally and in production.
# The redirect URI must match the public backend origin character for character.
# `make doctor` prints both values for whatever FRONTEND_URL is currently set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (password reset & signup OTP). Blank SMTP_HOST logs the verification
# code and reset links to the console instead, so dev works without email credentials.
#
# To use your personal Gmail account with an App Password:
# 1. Turn on 2-Step Verification in Google Account (https://myaccount.google.com/security)
# 2. Go to App Passwords (https://myaccount.google.com/apppasswords)
# 3. Create a password named "Assay" (Google generates a 16-character code)
# 4. Fill in the values below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=Assay <your_email@gmail.com>
SMTP_STARTTLS=true
SMTP_SSL=false

# Enforce OTP verification on signup (true by default)
REQUIRE_EMAIL_VERIFICATION=true

# Error monitoring (optional). Paste a Sentry project DSN to be told when something
# breaks for a user. Blank disables it.
SENTRY_DSN=
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# ---- limits -------------------------------------------------------------
DAILY_CAP_USD=3.00
ANON_RUN_LIMIT=3
FREE_ACCOUNT_CREDITS=10
ANON_IP_DAILY_CAP=12
IP_HASH_SALT=change-me-too
SAMPLE_TICKER=MSFT

# ---- payments (Razorpay) -------------------------------------------------------
# Signed-in users can buy credit packs once their free monthly credits run out.
# Leave the keys blank and the "Buy credits" page says payments are not available yet;
# everything else works the same.
#
# This deployment runs in TEST MODE: the flow is fully real (orders, Checkout,
# signatures, webhooks, refunds) but uses Razorpay test keys, so no money moves. With
# PAYMENTS_TEST_MODE=true a live key (rzp_live_...) is refused, and each account can
# buy at most TEST_MAX_PURCHASES packs / TEST_MAX_CREDITS credits, because every
# credit is still a real analysis on your model bill.
#
# 1. Dashboard (switch to Test Mode) -> Account & Settings -> API Keys -> Generate Key.
# 2. Dashboard -> Account & Settings -> Webhooks -> Add New Webhook:
#      URL:     https://api.YOUR-DOMAIN/billing/webhook
#      Secret:  any long random string, pasted into RAZORPAY_WEBHOOK_SECRET below
#      Events:  payment.captured and order.paid
# 3. Keep automatic capture on (Account & Settings -> Payment capture), the default.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_TEST_MODE=true
TEST_MAX_PURCHASES=3
TEST_MAX_CREDITS=10
# Optional: change the packs without a deploy. Prices are in paise (2900 = Rs 29).
# CREDIT_PACKS=[{"id":"starter","name":"Starter","credits":2,"price_paise":2900},{"id":"pro","name":"Pro","credits":5,"price_paise":5900,"popular":true},{"id":"power","name":"Power","credits":10,"price_paise":9900}]
